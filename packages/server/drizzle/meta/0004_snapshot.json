        "tasks_status_check": {
          "name": "tasks_status_check",
          "value": "\"tasks\".\"status\" IN ('open', 'completed', 'abandoned')"
        },
        "tasks_dates_check": {
          "name": "tasks_dates_check",
          "value": "CASE\n        WHEN \"tasks\".\"all_day\" IS NULL THEN \"tasks\".\"start_date\" IS NULL AND \"tasks\".\"due_date\" IS NULL AND \"tasks\".\"start_at\" IS NULL AND \"tasks\".\"due_at\" IS NULL AND \"tasks\".\"time_zone\" IS NULL\n        WHEN \"tasks\".\"all_day\" THEN \"tasks\".\"due_date\" IS NOT NULL AND \"tasks\".\"start_at\" IS NULL AND \"tasks\".\"due_at\" IS NULL AND \"tasks\".\"time_zone\" IS NULL AND (\"tasks\".\"start_date\" IS NULL OR \"tasks\".\"start_date\" <= \"tasks\".\"due_date\")\n        ELSE \"tasks\".\"due_at\" IS NOT NULL AND \"tasks\".\"time_zone\" IS NOT NULL AND \"tasks\".\"start_date\" IS NULL AND \"tasks\".\"due_date\" IS NULL AND (\"tasks\".\"start_at\" IS NULL OR \"tasks\".\"start_at\" <= \"tasks\".\"due_at\")\n      END"
        }
