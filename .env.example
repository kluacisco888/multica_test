# dida-clone configuration. Copy to `.env` and adjust:  cp .env.example .env
# Keep `.env` when moving to another server — APP_ENCRYPTION_KEY cannot be
# recovered, and data encrypted with it is unreadable without it.

# ---- Network -------------------------------------------------------------
# Host address and port the app is published on. Default is loopback only;
# reach it from your laptop with:  ssh -L 8090:127.0.0.1:8090 <server>
APP_BIND=127.0.0.1
APP_PORT=8090
# External URL users open (behind a reverse proxy / CloudFront, put that URL here).
PUBLIC_URL=http://127.0.0.1:8090
# Which peers may set X-Forwarded-For/-Proto/-Host: true | false | hop count |
# comma list of IPs/CIDRs/presets (loopback, linklocal, uniquelocal).
TRUST_PROXY=loopback,linklocal,uniquelocal

# ---- Database ------------------------------------------------------------
# Password of the bundled PostgreSQL. Change it before the first start; it is
# stored in the database volume on first start.
POSTGRES_PASSWORD=change-me-please

# ---- Secrets -------------------------------------------------------------
# AES-256-GCM key for stored channel credentials (32 bytes, base64).
# Generate once with:  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ---- First administrator (created on first start if no user exists) -----
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# ---- Defaults ------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Shanghai
LOG_LEVEL=info
