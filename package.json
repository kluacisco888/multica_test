{
  "name": "dida-clone",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r typecheck",
    "test": "vitest run && pnpm test:e2e",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:fakes": "vitest run --project fakes",
    "test:e2e": "pnpm build && playwright test",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
